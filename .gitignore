# File of Sensitive API Keys
.env

# Grok local project config (per user setup in separate chat)
.grok/
# But allow project-specific instruction files to be committed for team use
!.grok/AGENTS.md
!.grok/skills/**/SKILL.md
!.grok/skills/**/AGENTS.md

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Runtime logs and history (keep the directory via .gitkeep)
logs/
!logs/.gitkeep

# Personal future ideas scratchpad (most content can stay private)
.future/
!.future/.gitkeep
!.future/README.md

# MkDocs build output (build with: uv run --extra docs mkdocs build)
site/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Test / coverage caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
